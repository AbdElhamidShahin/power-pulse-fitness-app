# Local secrets (Supabase) — مايتعملهاش commit أبداً
# انسخ dart_defines.example.json إلى dart_defines.json واملاه بالقيم الحقيقية
dart_defines.json
dart_defines.*.json
!dart_defines.example.json

# Firebase / Google Services — مايتعملهاش commit أبداً
# نزّلهم من Firebase Console وحطّهم محلياً بس
google-services.json
GoogleService-Info.plist

# Android signing / upload certificate — مايتعملهاش commit أبداً
android/app/upload_certificate.pem
android/app/*.jks
android/app/*.p12
android/key.properties

